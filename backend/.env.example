# Server
PORT=3001
NODE_ENV=production

# Database - PostgreSQL (use Supabase or similar)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (use cloud Redis like upstash.com)
REDIS_URL=redis://:password@host:port

# Frontend URL (for CORS - set after Vercel deployment)
FRONTEND_URL=https://your-vercel-domain.vercel.app
FRONTEND_URL=http://localhost:3000

# Naver SMTP Configuration
NAVER_EMAIL=your_email@naver.com
NAVER_APP_PASSWORD=your_app_password
NAVER_SMTP_HOST=smtp.naver.com
NAVER_SMTP_PORT=465
EMAIL_DEV_MODE=true
